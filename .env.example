# CadetMate environment variables
# Copy to .env.local for local development. Never commit secrets.

# ── Public (browser-exposed) ─────────────────────────────────────
# Public site origin — use your ngrok URL when tunneling locally, e.g.:
# NEXT_PUBLIC_URL=https://abcd1234.ngrok-free.app
NEXT_PUBLIC_URL=https://cadetmate.co.uk
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_...
NEXT_PUBLIC_STRIPE_PRICING_TABLE_ALL=prctbl_...
NEXT_PUBLIC_STRIPE_PRICING_TABLE_PREMIUM=prctbl_...

# Analytics (optional — leave blank to disable)
# GA4 Measurement ID from Google Analytics → Admin → Data streams
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Search Console HTML-tag verification content (meta name="google-site-verification")
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Server secrets (never prefix with NEXT_PUBLIC_) ───────────────
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PREMIUM_PRICE_IDS=price_xxx,price_yyy

# Optional webhook for client JS errors (Slack/Discord/etc.)
# ERROR_WEBHOOK_URL=https://hooks.example.com/...

# Optional: OpenAI moderation
OPENAI_API_KEY=

# SMTP (support tickets)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=CadetMate Support
SMTP_FROM_EMAIL=support@cadetmate.co.uk
SMTP_ADMIN_EMAIL=support@cadetmate.co.uk

# PDF watermark fetch allowlist (comma-separated hosts; Supabase host added automatically)
# PDF_ALLOWED_HOSTS=cdn.example.com
