# CadetMate environment variables
# Copy to .env.local for local development. Never commit secrets.

# ── Public (browser-exposed) ─────────────────────────────────────
# Public site origin (canonical domain for sitemap.xml <loc> URLs — must be HTTPS in prod).
# For ngrok local tunnels set this to your tunnel URL, e.g.:
#   NEXT_PUBLIC_URL=https://abcd1234.ngrok-free.app
# Then restart `next dev`. Also add that origin in Supabase → Authentication → URL Configuration:
#   Site URL:     https://abcd1234.ngrok-free.app
#   Redirect URLs:
#     http://localhost:3000/**
#     https://abcd1234.ngrok-free.app/**
#     https://cadetmate.co.uk/**
# (This is a Next.js app — use NEXT_PUBLIC_*, not VITE_*.)
# Sitemap at /sitemap.xml also needs the Supabase anon pair below to load published Slug blog posts.
NEXT_PUBLIC_URL=https://cadetmate.co.uk
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_...

# Analytics (optional — leave blank to disable)
# GA4 Measurement ID from Google Analytics → Admin → Data streams
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Search Console HTML-tag verification content (meta name="google-site-verification")
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Server secrets (never prefix with NEXT_PUBLIC_) ───────────────
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Recurring Price ID for CadetMate Premium (required for /pricing display + subscribe)
STRIPE_PREMIUM_PRICE_ID=price_xxx
# Optional extra Price IDs that also grant Premium (comma-separated)
# STRIPE_PREMIUM_PRICE_IDS=price_old,price_promo

# Optional webhook for client JS errors (Slack/Discord/etc.)
# ERROR_WEBHOOK_URL=https://hooks.example.com/...

# Optional: OpenAI (server-only — never prefix with NEXT_PUBLIC_)
# If this key was previously exposed as NEXT_PUBLIC_OPENAI_API_KEY, rotate it.
OPENAI_API_KEY=

# Shared secret for the assign-daily-question Edge Function (header: x-cron-secret).
# Also set this in the Supabase function secrets. Disable JWT verification on that function.
# DAILY_QUESTION_CRON_SECRET=

# SMTP (support tickets)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=CadetMate Support
SMTP_FROM_EMAIL=support@cadetmate.co.uk
SMTP_ADMIN_EMAIL=support@cadetmate.co.uk

# Offline licence (ES256). Server signs; the app stores the JWT in Keychain.
# Generate with: openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt
# then: openssl ec -in private.pem -pubout
# Put PEM in env with literal \n for newlines.
OFFLINE_LICENCE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
OFFLINE_LICENCE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# PDF watermark fetch allowlist (comma-separated hosts; Supabase host added automatically)
# PDF_ALLOWED_HOSTS=cdn.example.com
