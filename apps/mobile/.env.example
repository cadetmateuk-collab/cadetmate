EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Local Next.js origin for session-check, downloads, and sync.
# Simulator: http://localhost:3000
# Physical phone: http://YOUR_LAN_IP:3000 (same machine as npm run dev)
# Do not use https://cadetmate.co.uk until /api/mobile is deployed.
EXPO_PUBLIC_WEB_URL=http://localhost:3000
