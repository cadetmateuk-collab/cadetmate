{
  "expo": {
    "name": "CadetMate",
    "slug": "cadet-mate",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "cadetmate",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "uk.co.cadetmate.app",
      "adaptiveIcon": {
        "backgroundColor": "#F5F7FB"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "cadetmate",
              "host": "*"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "ios": {
      "bundleIdentifier": "uk.co.cadetmate.app",
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-font",
      "expo-secure-store",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "autolinkingModuleResolution": true
    }
  }
}
