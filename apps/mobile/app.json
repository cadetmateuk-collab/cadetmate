{
  "expo": {
    "name": "CadetMate",
    "slug": "cadet-mate",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "cadetmate",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "uk.co.cadetmate.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B1F3A"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "cadetmate",
              "host": "*"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "ios": {
      "bundleIdentifier": "uk.co.cadetmate.app",
      "supportsTablet": true
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "replace-with-eas-project-id"
      }
    }
  }
}
