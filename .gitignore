# local SQL dumps / schema exports (keep supabase/migrations/)
/schema.sql
/schemas.sql
/*.sql
*.dump
*.backup
pg_dump*
supabase/.temp/
supabase/.branches/

# Cursor MCP (personal access token)
.cursor/mcp.json

# vercel / local tunnels
.vercel
ngrok.yml
*.ngrok.yml

# typescript
*.tsbuildinfo

# Internal build / deploy docs — not pushed to GitHub
/docs/

# Capacitor / Android / Expo — keep native projects; ignore build/output noise
apps/mobile-shell/android/app/build/
apps/mobile-shell/android/build/
