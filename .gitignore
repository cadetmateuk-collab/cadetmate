# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
**/node_modules/
node_modules/

# testing
/coverage
coverage/
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/
playwright-report/
test-results/
blob-report/

# next.js
/.next/
/out/
next-env.d.ts

# production
/build
/dist
/.server-out/
dist/
build/

# misc
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — commit templates only (.env.example)
.env
.env.*
!.env.example
!**/.env.example

# secrets / signing material
*.pem
*.p8
*.p12
*.mobileprovision
*.jks
*.keystore
*.key
id_rsa
id_rsa.pub
credentials.json
service-account*.json
google-services.json
