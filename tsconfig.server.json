{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2017",
    "lib": ["es2017"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": false,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": false,
    "outDir": ".server-out",
    "baseUrl": ".",
    "paths": { "@/*": ["./*"] }
  },
  "include": ["server.ts", "lib/**/*"],
  "exclude": [
    "lib/useSessionReporter.tsx",
    "lib/hooks/useActivityTracker.ts",
    "lib/hooks/useIsMobile.ts",
    "lib/formatCardText.tsx"
  ]
}